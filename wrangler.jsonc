{
  // Nome do Worker na Cloudflare.
  "name": "vitalis-barreira-glosas",
  // Ponto de entrada do Worker (fetch handler).
  "main": "src/worker/index.ts",
  // Data de compatibilidade da Workers Runtime.
  "compatibility_date": "2026-09-20",
  // Habilita as APIs Node.js suportadas dentro do Worker.
  "compatibility_flags": ["nodejs_compat"],
  // Ativa logs e métricas de observabilidade do Worker.
  "observability": {
    "enabled": true
  },
  // Serve o build estático do cliente React (SPA) por baixo de env.ASSETS.
  //
  // `run_worker_first` existe porque, com `single-page-application`, QUALQUER navegação HTML
  // casa com o fallback do index.html e nunca chegaria ao Worker. As telas de identidade
  // (login, autorização OAuth) são HTML servido pelo Worker, não pela SPA — sem esta lista,
  // "/entrar" abriria a SPA numa rota que ela não conhece, em vez da tela de login.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/entrar", "/sair", "/oauth/*", "/.well-known/*", "/mcp", "/api/*"]
  },
  // Banco D1: guias, protocolos, eventos e regras (schema real entra na Fase 1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitalis-glosas",
      // database_id do D1 remoto criado na Fase 5. Não é segredo: sem credencial da conta ele não dá acesso.
      "database_id": "52e0cd0a-1784-4f06-ac38-6b74b8f26176"
    }
  ],
  // Bucket R2 privado para evidências (prints, PDFs) anexadas às ações.
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "vitalis-evidencias"
    }
  ],
  // Binding de Workers AI, usado a partir da Fase 4 para interpretar texto livre.
  // Sempre remoto (sem emulação local): "pnpm dev" exige CLOUDFLARE_ACCOUNT_ID no
  // ambiente quando há mais de uma conta Cloudflare autenticada. Ver docs/CONFIG.md.
  "ai": {
    "binding": "AI"
  }
}
